:80 {
    # 1. Enforce max upload size at the proxy level (protects Python from memory exhaustion)
    request_body {
        max_size 10MB
    }

    # 2. Production Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # 3. Reverse proxy to the internal FastAPI service
    reverse_proxy api:8000 {
        health_uri /api/v1/health/live
        health_interval 15s
        health_timeout 5s

        transport http {
            response_header_timeout 60s
            dial_timeout 5s
        }
    }

    # 4. JSON formatted access logs
    log {
        output stdout
        format json
    }
}