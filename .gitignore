# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# Flutter
.dart_tool/
.flutter-plugins*
build/
coverage/


# Machine learning

# Ignore raw and local datasets
ml/data/*
!ml/data/splits/

# Ignore large generated manifests and reports
ml/data/clean_manifest.csv
ml/data/clean_manifest_summary.json
ml/data/dataset_summary.json

# Keep reproducible split metadata
!ml/data/splits/*.csv
!ml/data/splits/*.json

# Ignore training experiments by default
ml/experiments/*
!ml/experiments/efficientnet_b0/

# Allow only the selected checkpoint
ml/experiments/efficientnet_b0/*
!ml/experiments/efficientnet_b0/best_finetuned_weights.h5

# Ignore other model files
*.h5
*.keras
*.ckpt
*.tfrecord

# Explicitly include our production checkpoint
!ml/experiments/efficientnet_b0/best_finetuned_weights.h5

# Generated reports and backup
ml/reports/
ml/reports_backup/
ml/figures/
.ipynb_checkpoints/


# Generated dataset reports
ml/reports/

# IDE and OS
.idea/
.vscode/
.DS_Store
Thumbs.db